TARGET_DESC="Express (Node/mocha) — second ecosystem. 3 pure commands, all served."

# Why express: it answers "does this work outside Python" with a name everyone
# recognises, and it is genuinely cheap — 213 tracked files and a 5.3s
# `npm install`, against sympy's ~2 minutes. It also exercises a completely
# different fingerprinting path (internal/hp/eco_node.go: lockfile plus a
# one-level node_modules listing) rather than re-running the Python one.
#
# Measured here: npm test 1.4s and npm run test-tap 1.2-1.7s, both comfortably
# over the 500 ms floor. `npm run lint` was measured at 754 ms standalone and
# 495 ms warm, straddles the floor, and was dropped for it — see
# express.cmds.
TARGET_UPSTREAM="https://github.com/expressjs/express.git"
TARGET_DIR="${HOME}/src/express-hs"
TARGET_CMDS="scripts/demo-targets/express.cmds"

TARGET_SETUP='
	command -v npm >/dev/null 2>&1 || { echo "npm is not installed"; exit 1; }
	npm install --no-audit --no-fund
'

TARGET_SHELL_ENV=""

# node_modules is gitignored, so `git worktree add` produces a checkout with
# no dependencies and `npm test` dies with "mocha: command not found". The
# symlink is not a workaround for the cache — it is what makes the worktree a
# working checkout at all.
#
# It also makes the fingerprint MORE correct, not less: with node_modules
# present, eco_node.go reads the same listing and the same
# node_modules/.package-lock.json in every worktree, so all five agents agree
# on the environment they are sharing results across. Measured: worktree and
# main clone produce identical tree hashes AND identical env fingerprints.
TARGET_WORKTREE_PREP='ln -sfn "'"${HOME}"'/src/express-hs/node_modules" node_modules'

# Observed once in about eight five-agent runs: an `npm test` whose mocha child
# had already exited but whose npm wrapper never did, wedging one agent. It did
# not reproduce in seven further trials (35 executions), so it is rare rather
# than systematic — but the commands here take two seconds, so a bound of 60
# is still forty times the headroom they need, and it turns a wedged agent from
# a dead demo into one missing lane.
TARGET_TIMEOUT=60

# No committed PreToolUse hook in the upstream clone, so the live-agent arm
# would measure nothing. Deterministic replay only.
TARGET_LIVE=0
