TARGET_DESC="Hindsight itself (Go) — shows the purity gate refusing. BACKUP, read the caveat."

# Self-referential and memorable: we cache our own test suite. It is also the
# only target where we found a NATURAL purity-gate refusal, which is the more
# valuable half — see fasthack-go.cmds.
#
# READ THIS BEFORE PUTTING IT ON STAGE. Plain `go test ./...` is unusable as a
# demo target and we measured why, three separate ways:
#
#   1. Go has its own test cache. Cold 8.6s, warm 0.28s — the warm run is
#      BELOW the 500 ms floor, so after a few observations the fastpath memo
#      stops intercepting it and the counter sits at zero.
#   2. It would inflate the headline number roughly thirtyfold. Hindsight
#      credits itself the RECORDED duration of what it served, 8.6s, while the
#      honest counterfactual for agents two through five is the 0.28s they
#      would actually have spent because Go's cache would have answered them.
#   3. It breaks shadow verification. Cold prints "ok ... 7.426s", warm prints
#      "ok ... (cached)". norm.go collapses the first to "{{DUR}}" and leaves
#      the second alone, so re-executing a served result reports a divergence
#      that is not one.
#
# `-count=1` fixes all three at once: it defeats Go's test cache, so every run
# genuinely re-executes at ~7.6s, always over the floor, always printing a
# real duration that normalises cleanly. The deleted seconds are then real
# work that would really have happened. Measured: 7930 / 7700 / 7637 ms across
# three consecutive runs.
#
# The honest talking point stands either way: Go already has a build cache,
# and Hindsight is for the enormous majority of commands that do not.
TARGET_UPSTREAM=""
TARGET_DIR="$HS_ROOT"
TARGET_CMDS="scripts/demo-targets/fasthack-go.cmds"

TARGET_SETUP=""

# TestEnvFingerprintDistinguishesVenvs fails whenever a Python virtualenv is
# active (ISSUES_FOR_TOM.md issue 0, Tom's to fix). It matters more here than
# elsewhere: Go does not cache FAILING test results, so a red suite silently
# changes the timing characteristics this target was measured with.
TARGET_SHELL_ENV='export VIRTUAL_ENV=""'

TARGET_WORKTREE_PREP=""

# The probe deliberately runs a command that writes cover.out, and it runs in
# this checkout rather than a throwaway worktree.
TARGET_CLEANUP='rm -f cover.out'

# Five concurrent `go test -count=1` runs contend hard for CPU, and the second
# command's peers additionally wait out a lease before discovering the record
# is unservable. 7.6s solo needs a lot of headroom under that.
TARGET_TIMEOUT=300

# Never 1. `hindsight init` installs a PreToolUse hook into .codex/hooks.json,
# and in THIS repo that is the hook intercepting the session you would use to
# fix the hook. The deterministic arm is safe because replay-agent.sh invokes
# `hindsight hook` directly and installs nothing.
TARGET_LIVE=0
