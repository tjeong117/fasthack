TARGET_DESC="SymPy (Python/pytest) — the headline demo. 3 pure commands, all served."

# Why sympy: a real, recognisable, 2000-file repository that is pure Python
# with one runtime dependency, so it installs in seconds instead of minutes.
# That matters more than it sounds. The cache has a 500 ms duration floor, so
# the target must have commands that genuinely take seconds. sympy's per-file
# test targets run 2.5-3s, well clear of the floor, and the tree stays clean
# afterwards so the purity gate is satisfied. Apache Beam was rejected: Gradle
# plus a multi-minute multi-language install is a demo that fails on stage.
TARGET_UPSTREAM="https://github.com/sympy/sympy.git"
TARGET_DIR="${HOME}/src/sympy"
TARGET_CMDS="scripts/demo-targets/sympy.cmds"

# hypothesis is required by sympy/conftest.py; without it every test errors out.
TARGET_SETUP='
	command -v uv >/dev/null 2>&1 || { echo "uv is not installed"; exit 1; }
	[ -d .venv ] || uv venv .venv
	uv pip install -q -e . pytest hypothesis
'

# Activating the venv here rather than asking the operator to remember it is
# the difference between a demo that works and one that fails with "pytest
# cannot import sympy" thirty seconds in. fleet.sh passes the environment
# through to the agents, so sourcing it once here reaches all five.
TARGET_SHELL_ENV='
	# shellcheck disable=SC1091
	[ -f "$TARGET_DIR/.venv/bin/activate" ] && . "$TARGET_DIR/.venv/bin/activate"
'

# All five worktrees deliberately share the one venv in the main clone, so
# there is nothing to put back per worktree.
TARGET_WORKTREE_PREP=""

# The only target with a committed PreToolUse hook, so the only one that can
# drive real coding agents.
TARGET_LIVE=1
